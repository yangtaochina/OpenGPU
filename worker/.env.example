# ---------------------------------------------------------------------------
# OpenGPU GPU Worker configuration example.
#
# Copy this file to `.env` (same directory as worker.py) and fill in the values.
# The worker loads `worker/.env` automatically at startup; real environment
# variables always win over the file.  Nothing here is required except
# OPENGPU_WORKER_TOKEN.
# ---------------------------------------------------------------------------

# --- Platform connection ---------------------------------------------------
# Base URL of the 智由 control plane.
OPENGPU_API_BASE=http://localhost:8080

# REQUIRED. One-time token issued when the worker is created in the admin page
# or via POST /api/admin/workers. Format: wkr_<uuid>_<secret>.
OPENGPU_WORKER_TOKEN=wkr_00000000-0000-0000-0000-000000000000_replace_me

# --- Node identity ---------------------------------------------------------
# Defaults to the machine hostname when unset.
OPENGPU_WORKER_NAME=gpu-node-01
OPENGPU_GPU_MODEL=RTX 4090
OPENGPU_WORKER_VERSION=0.1.0
OPENGPU_MODEL_VERSION=MiniMax-H3

# --- GPU capability (used by the platform to match video requirements) -----
# The platform only hands this node a task whose requirement it can satisfy
# (see docs/API.md §7).  Report REAL values on a production node.
#
# OPENGPU_VRAM_MB=0 (default) means "not reported": the node can then only
# claim tasks that have no hardware requirement at all.  So a real node MUST
# set this, ideally from nvidia-smi --query-gpu=memory.total --format=csv,noheader.
OPENGPU_VRAM_MB=24576
# Optional. One of ENTRY | STANDARD | PRO | ULTRA.
# Leave empty to let the server derive the tier from OPENGPU_VRAM_MB.
OPENGPU_GPU_TIER=PRO
# Longest clip this node accepts, in seconds. 0 = unlimited.
OPENGPU_MAX_DURATION_SECONDS=15
# Informational only, shown in the admin UI.
OPENGPU_SUPPORTED_RESOLUTIONS=480P,720P,1080P,4K

# NOTE: the values above match the project's mock/dev node so that the
# "video requirement -> GPU matching" flow can be exercised without a GPU.
# They are DECLARED capabilities, not detected ones.  Replace them with real
# hardware values before connecting an actual GPU machine.

# --- Timing ----------------------------------------------------------------
# Seconds between heartbeats (the server may override this via the heartbeat
# response `heartbeatIntervalSeconds`).
OPENGPU_HEARTBEAT_INTERVAL=20

# Long-poll wait for /api/worker/tasks/claim. 0-30; values above 30 are clamped.
OPENGPU_POLL_WAIT_SECONDS=20

# --- Storage / scratch -----------------------------------------------------
# Relative paths are resolved against the worker/ directory.
OPENGPU_WORK_DIR=./work

# Refuse to upload results larger than this many bytes (2 GiB default).
OPENGPU_MAX_UPLOAD_BYTES=2147483648

# --- Engine ----------------------------------------------------------------
# `mock` (local test engine, default) or `h3` (MiniMax H3 adapter, M0 stub).
OPENGPU_ENGINE=mock

# Mock engine: simulated render time in seconds (progress 0 -> 100).
OPENGPU_MOCK_DURATION_SECONDS=6
# Mock engine: optional path to an existing mp4 used when ffmpeg is missing.
# OPENGPU_MOCK_SAMPLE_VIDEO=./samples/sample.mp4

# --- MiniMax H3 engine (M0 stub; only after deployment validation) ----------
# Command template with {prompt} and {output} placeholders. Parsed as an argv
# list (never through a shell), so no pipes/&&/redirection.
# OPENGPU_H3_COMMAND=python infer.py --prompt {prompt} --out {output}
OPENGPU_H3_TIMEOUT=3600

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
OPENGPU_LOG_LEVEL=INFO
